# Dead Link Séance — environment variable template.
#
# Copy this file to `.env` and fill in real values for local development:
#   cp .env.example .env
#
# `.env` is gitignored (see .gitignore). NEVER commit real API keys or the
# `.env` file itself. Only `.env.example` (this file) is tracked, and it must
# never contain real secrets — leave placeholder values only.

# AI_BASE_URL — OPTIONAL
# Base URL of an OpenAI-compatible Chat Completions API.
# Default: https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1

# AI_API_KEY — OPTIONAL
# Enables the AI "medium" that writes the summary and cause of death.
# When unset or empty, the app still shows the restored page WITHOUT a
# summary/cause-of-death (graceful degradation).
AI_API_KEY=

# AI_MODEL — OPTIONAL
# The model name to use for completions.
# Default: gpt-4o-mini
AI_MODEL=gpt-4o-mini
